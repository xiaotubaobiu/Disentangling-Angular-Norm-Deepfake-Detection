+def _batch_list(value, size):
+    if isinstance(value, torch.Tensor):
+        result = value.detach().cpu().tolist()
+    elif isinstance(value, (str, bytes)):
+        result = [value] * size
+    else:
+        result = list(value)
+    if len(result) != size:
+        raise ValueError(f"batch field has {len(result)} values; expected {size}")
