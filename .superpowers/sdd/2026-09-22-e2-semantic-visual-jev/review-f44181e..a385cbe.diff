+    return DataLoader(
+        dataset,
+        batch_size=batch_size,
+        sampler=sampler,
+        shuffle=False,
+        drop_last=False,
+        generator=generator,
+        **_dataloader_kwargs(num_workers, prefetch_factor),
+    )
+
+
